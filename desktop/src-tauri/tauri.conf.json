{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdenVoice",
  "version": "0.8.5",
  "identifier": "dev.edenvoice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "EdenVoice",
        "width": 820,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "zoomHotkeysEnabled": false,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SmileSion",
    "category": "SocialNetworking",
    "shortDescription": "轻量、稳定的跨平台语音协作客户端",
    "longDescription": "EdenVoice 是一款简约、低延迟的跨平台语音协作客户端。",
    "copyright": "Copyright © 2026 SmileSion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libdbus-1-3",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0",
          "libasound2"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-only",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGQjREMUIxMjk0Q0E3QzEKUldUQnAwd3BzZEcwN3c2azN1RVBubS85eEJvYjFUTEY5V0MzZmk3a1IzTEJYbkcvWTArVFhWUlkK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "edenvoice"
        ]
      }
    }
  }
}
