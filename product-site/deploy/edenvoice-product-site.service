[Unit]
Description=EdenVoice Product Introduction Site
After=network.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/edenvoice-product-site/current
ExecStart=/usr/bin/python3 -m http.server 7003 --bind 0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
